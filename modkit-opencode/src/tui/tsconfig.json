{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // The TUI part, which opencode compiles with its own Solid onto OpenTUI.
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["es2023", "dom"],
    "types": [],
    // Copied into the mod as source, so nothing builds declarations from it.
    "isolatedDeclarations": false,
    "declaration": false
  },
  "include": [".", "../contract.ts"]
}
