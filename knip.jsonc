{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    "modkit-claude-code": {
      // Claude Code provides `claude-code` to a mod, and the codegen writes `modkit-claude:state`.
      "ignoreDependencies": ["claude-code", "modkit-claude"],
    },
  },
  // codespell, actionlint and zizmor are Python packages; their scripts run them pinned through uvx.
  "ignoreBinaries": ["uvx"],
}
