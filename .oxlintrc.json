{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "options": { "typeAware": true },
  "ignorePatterns": [
    // Oxlint has no built-in node_modules skip; without these it lints every dependency.
    "**/node_modules/**",
    "**/dist/**"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    // Flags `TODO(markovejnovic): ...`, the convention for owned debt.
    "eslint/no-warning-comments": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    // Only applies to the classic JSX runtime; mods compile against modkit's automatic one.
    "react/react-in-jsx-scope": "off",

    // In typescript-eslint's strict-type-checked, but still nursery in Oxlint.
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-optional-chain": "error",

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "eslint/prefer-template": "error",
    "eslint/prefer-const": "error",
    // Props and payloads take one object.
    "eslint/max-params": ["error", { "max": 2 }],
    "eslint/max-lines": ["error", { "max": 900 }],
    "eslint/no-nested-ternary": "error",
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/array-type": "error",
    "import/no-cycle": "error",

    // `() => undefined` is how a mod's handler says it has no opinion.
    "unicorn/no-useless-undefined": ["error", { "checkArrowFunctionBody": false }],

    // A library never prints or exits for its caller; the CLI is the exception below.
    "eslint/no-console": "error",
    "unicorn/no-process-exit": "error"
  },
  "overrides": [
    {
      // Claude Code calls a hook as `($, e, next)` and declares its API so; the adapter keeps to it.
      "files": ["packages/targets/claude/src/runtime/**"],
      "rules": { "eslint/max-params": "off" }
    },
    {
      "files": ["packages/cli/src/**"],
      "rules": { "eslint/no-console": "off", "unicorn/no-process-exit": "off" }
    },
    {
      // Bundled into Claude Code mods, whose environment has no Node: everything outside the
      // module is reached through `$`.
      "files": ["packages/modkit/src/**", "packages/targets/claude/src/runtime/**"],
      "rules": { "import/no-nodejs-modules": "error" }
    }
  ]
}
