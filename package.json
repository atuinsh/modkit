{
  "name": "@atuin/modkit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "examples": "pnpm -r --filter './examples/*' build",
    "docs:build": "pnpm --filter docs build",
    "docs:dev": "pnpm --filter docs dev",
    "typecheck": "tsc -p . && pnpm -r --no-sort --no-bail --if-present typecheck",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip && knip --production --strict",
    "spell": "uvx --from codespell==2.4.3 codespell",
    "actionlint": "uvx --from actionlint-py==1.7.12.25 actionlint",
    "zizmor": "uvx zizmor==1.32.0 ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "^6.38.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.7",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
