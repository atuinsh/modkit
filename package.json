{
  "name": "@atuin/modkit-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "typecheck": "pnpm -r --no-sort --no-bail --if-present typecheck",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "spell": "uvx --from codespell==2.4.3 codespell"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "^6.38.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsdown": "^0.23.7",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  }
}
